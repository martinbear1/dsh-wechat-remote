{
  "name": "dsh-wechat-remote",
  "version": "1.7.14-rc.58",
  "private": false,
  "description": "Agent远程管理助手：DSH 微信连接插件的一键安装与升级",
  "type": "module",
  "license": "MIT",
  "bin": { "dsh-wechat-remote": "bin/setup.mjs" },
  "exports": {
    "./resource-library": "./native/lib/resource-library-component.js",
    "./resource-library/locale/*.json": "./native/lib/private-resources/locales/*.json",
    "./private-resource-prompt": "./native/lib/private-resources/native.js",
    "./clawbot": "./native/lib/clawbot-component.js",
    "./clawbot/locale/*.json": "./native/lib/clawbot/locales/*.json",
    "./collaboration": "./native/lib/collaboration.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./native/lib/assistant-presets/locales/main/*.json",
    "./assistant-teacher": "./native/lib/assistant-presets/builtin-teacher.js",
    "./assistant-project": "./native/lib/assistant-presets/builtin-project.js",
    "./assistant-customizer": "./native/lib/assistant-presets/builtin-customizer.js",
    "./assistant-teacher/locale/*.json": "./native/lib/assistant-presets/locales/teacher/*.json",
    "./assistant-project/locale/*.json": "./native/lib/assistant-presets/locales/project/*.json",
    "./assistant-customizer/locale/*.json": "./native/lib/assistant-presets/locales/customizer/*.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "files": ["cordis.patch.yml", "native/index.js", "native/package.json", "native/lib", "native/THIRD-PARTY-NOTICES", "bin/*.mjs", "lib/*.js", "lib/package.json", "assets/plugin.tgz", "assets/release.json", "README.md", "LICENSE"],
  "engines": { "node": ">=22.13.0" },
  "dependencies": { "mdast-util-from-markdown": "2.0.3", "pngjs": "7.0.0", "jpeg-js": "0.4.4", "pnpm": "11.22.0", "yaml": "2.9.0", "qrcode": "^1.5.4", "tweetnacl": "^1.0.3", "ws": "^8.18.3", "zod": "^4.4.3" },
  "bundleDependencies": ["mdast-util-from-markdown", "pngjs", "jpeg-js", "pnpm", "yaml", "qrcode", "tweetnacl", "ws", "zod"],
  "repository": { "type": "git", "url": "git+https://github.com/martinbear1/dsh-wechat-remote.git", "directory": "installer" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" }
}
