{
  "name": "@harness-remote/dsh-wechat-remote",
  "version": "1.0.1",
  "description": "Harness Remote 微信版：微信小程序扫码配对（openid 一对一身份绑定 + 每次启动复核 + 凭证滚动），局域网直连本机 DeepSeek Harness（认证网关宿主插件 + 侧边栏配对按钮客户端插件 + bundle 聚合，单包安装）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5",
    "@deepseek-ai/cordis": ">=4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "cordis.patch.yml"
  ]
}
